# ============================================================================
#  AluChop — Restaurant Management System
#  Ignore build output, generated artefacts and OS cruft.
#  Folder placeholders (.gitkeep) are kept so the directory tree survives.
# ============================================================================

# --- Build output -----------------------------------------------------------
build/
build-*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
compile_commands.json
*.o
*.obj
*.a
*.so
*.dylib
/AluChop
/AluChop.app/

# --- Qt generated -----------------------------------------------------------
*_autogen/
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qmlc
.qmake.stash

# --- Generated runtime output (folders are tracked, contents are not) -------
reports/*
!reports/.gitkeep
exports/*
!exports/.gitkeep
logs/
*.log

# --- Databases, backups, raw file-handling artefacts ------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.bin
*.bak

# --- Editors / IDEs ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.cache/
.clangd/

# --- macOS / OS cruft -------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
